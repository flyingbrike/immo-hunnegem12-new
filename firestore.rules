rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      // It's possible email_verified is not set for all providers, but for Google it is.
      return request.auth.token.get('email_verified', false) == true;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.get('email', '').lower() == 'eriksuniverse@gmail.com';
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid || 
        isAdmin()
      );
      allow update: if isAdmin();
    }

    match /surroundings_gallery/{imageId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid || 
        isAdmin()
      );
      allow update: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
