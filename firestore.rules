rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Gallery Rules
    match /gallery/{imageId} {
      // Anyone can see the photos
      allow read: if true;
      
      // Only signed in users can create/delete
      allow create: if isSignedIn() 
                     && isValidId(imageId)
                     && isValidGalleryImage(request.resource.data)
                     && request.resource.data.ownerId == request.auth.uid;
      
      allow delete: if isSignedIn() 
                     && (resource.data.ownerId == request.auth.uid);

      // No updates for now
      allow update: if false;
    }

    match /surroundings_gallery/{imageId} {
      allow read: if true;
      allow create: if isSignedIn() 
                     && isValidId(imageId)
                     && isValidGalleryImage(request.resource.data)
                     && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() 
                     && (resource.data.ownerId == request.auth.uid);
      allow update: if false;
    }

    function isValidGalleryImage(data) {
      return data.keys().hasAll(['url', 'title', 'createdAt', 'ownerId'])
             && data.keys().size() == 4
             && data.url is string && data.url.size() <= 1000000
             && data.title is string && data.title.size() <= 200
             && (data.createdAt is timestamp || data.createdAt is int)
             && data.ownerId == request.auth.uid;
    }
  }
}
